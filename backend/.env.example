# Comma-separated list of free-tier Gemini API keys (multiple keys = more effective free quota,
# the router round-robins across them). At least one is required.
GEMINI_API_KEYS=key1,key2

# Optional. Only add these if you have keys — neither provider has a persistent free API tier,
# so the router treats them as opportunistic fallback, not something to depend on.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local Ollama instance used as: (a) last-resort OCR fallback if every cloud vision candidate
# is exhausted, and (b) the primary free fallback for the text-only grading stage.
OLLAMA_BASE_URL=http://localhost:11434

DATABASE_URL=sqlite+aiosqlite:///./checkmate.db
STORAGE_ROOT=./storage
WORKER_COUNT=2
MODEL_REGISTRY_PATH=./app/routing/model_registry.yaml
